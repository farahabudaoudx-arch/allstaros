# All Star OS Gateway runner production environment (Mac)
# Store the real file outside Git, for example:
#   ~/.config/allstaros-gateway/runner.env
# chmod 600 the real file.

GATEWAY_RUNNER_BACKEND_BASE_URL=https://app.example.com
GATEWAY_RUNNER_ALLOWED_CALLBACK_ORIGINS=https://app.example.com

# These MUST exactly match the Vercel production values.
GATEWAY_AGENT_CONNECT_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
GATEWAY_AGENT_REPORT_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS
# Exact Supabase project origin allowed to receive signed raw-XLSX uploads.
GATEWAY_RUNNER_ARTIFACT_UPLOAD_ORIGIN=https://PROJECT.supabase.co

# Generate with: openssl rand -base64 32
GATEWAY_RUNNER_SESSION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
GATEWAY_RUNNER_SESSION_DIR="/Library/Application Support/AllStarOSGateway/sessions"

# `auto` resolves to the real provider inside the checked-out release.
GATEWAY_RUNNER_PROVIDER_MODULE=auto

# HTTP-only personal Gateway authentication and report acquisition. The member
# submits credentials/OTP only to the signed HTTPS runner Connect session. The
# runner persists only encrypted per-member HTTP session state; it never stores
# the Gateway password or OTP and no Chrome/Playwright runtime is required.
# The launch scripts default these to the managed venv/helper when left unset.
# GATEWAY_RUNNER_GATEWAY_HTTP_PYTHON=
# GATEWAY_RUNNER_GATEWAY_HTTP_HELPER_PATH=

GATEWAY_RUNNER_HOST=127.0.0.1
GATEWAY_RUNNER_PORT=8788
GATEWAY_RUNNER_CONCURRENCY=4
GATEWAY_RUNNER_CONNECT_CONCURRENCY=2
GATEWAY_RUNNER_LEASE_SECONDS=900
GATEWAY_RUNNER_POLL_INTERVAL_MS=10000
GATEWAY_RUNNER_REQUEST_TIMEOUT_MS=30000
# Session-validation guard only. Report batches use individually bounded export
# timeouts plus renewable lease fencing, so long first-connect history is allowed.
GATEWAY_RUNNER_PROVIDER_TIMEOUT_MS=120000
GATEWAY_RUNNER_CONNECT_TIMEOUT_MS=600000
GATEWAY_RUNNER_REQUEST_RETRIES=3

# Stable Cloudflare named-tunnel public hostname and remotely-managed tunnel token.
# Configure the Cloudflare public hostname to route to http://127.0.0.1:8788.
GATEWAY_RUNNER_PUBLIC_URL=https://gateway.example.com
GATEWAY_TUNNEL_TOKEN=REPLACE_WITH_CLOUDFLARE_TUNNEL_TOKEN

# Production safety: keep all acceptance/test-only values UNSET.
# GATEWAY_RUNNER_TEST_MODE=
