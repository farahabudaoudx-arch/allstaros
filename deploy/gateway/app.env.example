# All Star OS production environment (Vercel)
# Copy values into the existing Vercel project. Never commit real secrets.

NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_EXISTING_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_EXISTING_SERVICE_ROLE_KEY

# Stable public endpoint that reaches the Gateway runner's signed HTTP Connect surface.
GATEWAY_HOSTED_CONNECT_URL=https://gateway.example.com/connect

# Generate independent high-entropy secrets. The same two agent tokens must be
# present in the Mac runner environment.
GATEWAY_AGENT_CONNECT_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
GATEWAY_AGENT_REPORT_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS
CRON_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS

# Gateway reminder delivery uses the existing Resend integration.
RESEND_API_KEY=REPLACE_WITH_EXISTING_RESEND_KEY
RESEND_FROM=All Star <notifications@example.com>
# Optional; defaults to the application fallback when omitted.
RESEND_REPLY_TO=support@example.com
